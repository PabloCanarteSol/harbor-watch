# X (Twitter) API v2 credentials
X_BEARER_TOKEN=your_bearer_token_here
# Or OAuth 1.0a for posting tweets:
X_API_KEY=your_api_key
X_API_SECRET=your_api_secret
X_ACCESS_TOKEN=your_access_token
X_ACCESS_TOKEN_SECRET=your_access_token_secret

# MarineTraffic API (optional - web scrape fallback included)
MARINETRAFFIC_API_KEY=

# VesselFinder search token (for scraping)
VESSELFINDER_BASE_URL=https://www.vesselfinder.com
